// thoughts.py — data model
// Postgres everywhere (local dev points at the same Neon database).
// NOTE: `status`, `role`, `category` and `selectionMode` are validated Strings
// (see src/server/validation.ts) and `tags` is a JSON-encoded string[] — kept
// engine-portable on purpose.
// DATABASE_URL = pooled connection (runtime); DIRECT_URL = direct connection
// (migrations & seed). On a database with no pooler, set both to the same URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         String // "ADMIN" | "RECIPIENT"
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  sessions     Session[]
  visits       Visit[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique // sha256 of the cookie token — raw token never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
}

model Thought {
  id            String    @id @default(uuid())
  text          String
  status        String    @default("DRAFT") // DRAFT | QUEUED | SCHEDULED | PUBLISHED | EXPIRED | ARCHIVED
  category      String    @default("random")
  tags          String    @default("[]") // JSON-encoded string[]
  mood          String?
  doing         String? // owner context: what she was doing when the thought struck
  location      String? // owner context: where she was
  createdAt     DateTime  @default(now())
  scheduledFor  DateTime? // server-side only; never exposed to the recipient
  publishedAt   DateTime?
  expiresAt     DateTime?
  seenAt        DateTime? // first time the recipient decrypted it; surfaced to admin as a read receipt (spec §19 amended 2026-09-13) — he is told she can see it
  queuePosition Int?
  songId        String?
  song          Song?     @relation(fields: [songId], references: [id], onDelete: SetNull)
  replies       Reply[]

  @@index([status])
}

// Transmissions from the recipient back to the owner. `mischief` (1..5) is his
// self-rating of how feral the message is — it is shown to the admin BEFORE the
// text is decrypted, which is the entire point. Text stays server-redacted
// until seenAt is stamped by an explicit decrypt.
model Reply {
  id           String        @id @default(uuid())
  text         String // may be "" when the transmission is attachment-only
  mischief     Int           @default(1) // 1..5, validated in src/server/validation.ts
  songUrl      String? // AUDIO_REF: a song he wants the owner to hear (http(s), any provider)
  gifUrl       String? // attached gif (https; rendered as <img>) — redacted with the text until decrypt
  createdAt    DateTime      @default(now())
  seenAt       DateTime? // when the owner dared to open it
  responseText String? // LEGACY pre-chat downlink — carried into ChatMessage by 20260913150000; no longer read
  respondedAt  DateTime? // LEGACY, see responseText
  thoughtId    String?
  thought      Thought?      @relation(fields: [thoughtId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([createdAt])
}

// COMMS: every uplink transmission is a potential chat room. The owner's first
// message opens the channel; after that both parties post freely and nothing
// expires. Purging the root Reply deletes the whole room (cascade).
model ChatMessage {
  id        String   @id @default(uuid())
  replyId   String
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  sender    String // "OWNER" | "RECIPIENT" (validated string, engine-portable)
  kind      String   @default("TEXT") // "TEXT" | "GIF" (GIF: text holds the https url)
  text      String
  createdAt DateTime @default(now())

  @@index([replyId, createdAt])
}

model Song {
  id          String      @id @default(uuid())
  artist      String
  title       String
  album       String?
  artworkUrl  String?
  externalUrl String?
  createdAt   DateTime    @default(now())
  thoughts    Thought[]
  nowPlaying  NowPlaying?
}

// Singleton (id = 1): the owner's global "Currently Listening" state.
model NowPlaying {
  id        Int      @id @default(1)
  songId    String?  @unique
  song      Song?    @relation(fields: [songId], references: [id], onDelete: SetNull)
  updatedAt DateTime @updatedAt
}

model Visit {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  visitedAt DateTime @default(now())
  sessionId String

  @@index([userId, visitedAt])
}

// Singleton (id = 1): the machine's owner-editable vitals — the tamagotchi layer.
// Always fiction (spec §11): never real infrastructure data, just authored mood.
model Diagnostics {
  id              Int      @id @default(1)
  cpu             String   @default("emotionally unstable")
  memory          String   @default("mostly cats")
  storage         String   @default("97% thoughts")
  uptime          String   @default("questionable")
  latency         String   @default("emotional")
  catInterference String   @default("HIGH")
  occupiedPct     Int      @default(87)
  warning         String   @default("too many thoughts detected")
  flora           String   @default("THRIVING")
  updatedAt       DateTime @updatedAt
}

// Operator vitals — the tamagotchi layer inverts: the machine logs its human.
// WATER/FOOD are the owner's intake events (coolant refills / payload packets);
// PING is the recipient's hydration nudge. "Today" is computed in ET.
model OperatorEvent {
  id        String   @id @default(uuid())
  kind      String // "WATER" | "FOOD" | "PING" (validated string, see validation.ts)
  payload   String? // FOOD only: what the payload was
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

// REMINDER SIREN: tasks the owner must not forget. Anyone can arm one (it's
// mostly the recipient reminding her); the admin panel blares while a reminder
// is past due and unacknowledged. Only the owner acknowledges — silencing the
// siren is her admission that she saw it.
model Reminder {
  id        String    @id @default(uuid())
  task      String
  note      String?
  dueAt     DateTime // when the siren starts blaring
  createdBy String // "OWNER" | "RECIPIENT" (validated string, engine-portable)
  createdAt DateTime  @default(now())
  ackAt     DateTime? // owner acknowledgment — null means still armed

  @@index([ackAt, dueAt])
}

// JAZ://VAULT — the owner's DRAFT thoughts double as her private journal.
// The recipient sees only how many entries are sealed. A RevealRequest is his
// petition to unseal ONE entry; the owner approves (choosing which entry —
// its text is snapshotted at approval so later edits/deletes never rewrite
// what was revealed) or denies. One PENDING petition at a time.
model RevealRequest {
  id                String    @id @default(uuid())
  status            String    @default("PENDING") // PENDING | APPROVED | DENIED
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  revealText        String? // snapshot of the unsealed entry, stamped at approval
  revealedThoughtAt DateTime? // when she originally wrote that entry

  @@index([status, createdAt])
}

// Singleton (id = 1): HIM://STATUS — the recipient's self-reported telemetry,
// his mirror of the owner's mood/doing/location context. `cravingAt` is the
// HONEY CHICKEN PROTOCOL: only he arms it, either side clears it when fed,
// and the first declaration's timestamp is kept so the panel can report
// exactly how long the node has gone unfueled.
model RecipientStatus {
  id          Int       @id @default(1)
  mood        String?
  doing       String?
  location    String?
  note        String?
  telemetryAt DateTime? // when he last updated the fields above
  cravingAt   DateTime? // honey chicken protocol armed (null = fed / standby)
}

// Singleton (id = 1): owner-configurable scheduler settings.
// Intervals are minutes. lifetimeMin = 0 means "visible until the next thought replaces it".
model Settings {
  id             Int       @id @default(1)
  minIntervalMin Int       @default(240) // 4h
  maxIntervalMin Int       @default(2160) // 36h
  lifetimeMin    Int       @default(1440) // 24h
  selectionMode  String    @default("FIFO") // FIFO | RANDOM
  lastTickAt     DateTime? // also serves as a row lock so concurrent ticks serialize
}
