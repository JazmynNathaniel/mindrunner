# Copy to .env and fill in. NEVER commit .env.

# Postgres (Neon via Vercel Storage, or any Postgres).
# DATABASE_URL = pooled connection (runtime); DIRECT_URL = direct connection
# (migrations & seed). No pooler? Set both to the same URL.
DATABASE_URL=""
DIRECT_URL=""

# The two (and only two) accounts. Seed creates them; re-seeding never
# overwrites existing passwords (use scripts/set-password.ts to rotate).
ADMIN_USERNAME="jaz"
ADMIN_PASSWORD=""
RECIPIENT_USERNAME=""
RECIPIENT_PASSWORD=""

# Shared secret for the scheduled tick endpoint (/api/cron/tick).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
