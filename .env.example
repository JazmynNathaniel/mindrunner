# Copy to .env and fill in. NEVER commit .env.

# Postgres (Neon via Vercel Storage, or any Postgres).
# DATABASE_URL = pooled connection (runtime); DIRECT_URL = direct connection
# (migrations & seed). No pooler? Set both to the same URL.
DATABASE_URL=""
DIRECT_URL=""

# The two (and only two) accounts. Seed creates them; re-seeding never
# overwrites existing passwords (use scripts/set-password.ts to rotate).
ADMIN_USERNAME="jaz"
ADMIN_PASSWORD=""
RECIPIENT_USERNAME=""
RECIPIENT_PASSWORD=""

# Shared secret for the scheduled tick endpoint (/api/cron/tick).
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Spotify presence (optional). With all three set, the terminal shows the real
# currently-playing / last-played track; otherwise (or on any Spotify failure)
# it falls back to the manual entry from the admin panel.
# Client ID/secret: create an app at https://developer.spotify.com/dashboard
# with redirect URI http://127.0.0.1:8888/callback, then get the refresh token
# once with: npx tsx scripts/spotify-auth.ts
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""

# GIF ENGINE (optional). Server-side proxy key for Giphy search in the comms
# picker. Until set, /api/giphy answers 503 and the picker shows "gif engine
# offline" (direct gif urls still work everywhere). Get a key: giphy.com/dashboard
# -> Create an App -> API key. Set in Vercel env for prod, .env.local for dev.
GIPHY_API_KEY=""

# Last.fm presence (optional; takes precedence over Spotify when set). This is
# the YouTube Music bridge: YT Music has no public now-playing API, so a
# scrobbler (Pano Scrobbler on mobile, Web Scrobbler browser extension on
# desktop) reports plays to Last.fm and the terminal reads them back here.
# Covers anything that scrobbles, Spotify included. Just an API key — no OAuth.
# Get one at https://www.last.fm/api/account/create (any values for the
# callback fields; only the key matters). Unset or failing → next fallback.
LASTFM_API_KEY=""
LASTFM_USERNAME=""
